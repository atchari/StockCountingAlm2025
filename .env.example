# Backend Environment Variables
ASPNETCORE_ENVIRONMENT=Production

# Database Connection
DB_SERVER=your-db-server
DB_NAME=StockCountDB
DB_USER=your-user
DB_PASSWORD=your-password

# JWT Settings (สร้าง secret key ที่มีความปลอดภัย)
JWT_SECRET_KEY=your-secret-key-here-minimum-32-characters-for-security
JWT_ISSUER=StockCountAPI
JWT_AUDIENCE=StockCountClient
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_MINUTES=10080

# Frontend Environment Variables
VITE_API_URL=http://localhost:5000

# Ports
BACKEND_PORT=5000
FRONTEND_PORT=3000
DATABASE_PORT=1433

# SQL Server (if using Docker database)
SA_PASSWORD=YourStrong@Passw0rd
